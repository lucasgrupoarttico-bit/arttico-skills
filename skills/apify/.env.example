# Apify Ratos — Configuracao
# Copie este arquivo para .env e preencha. O .env NAO vai pro git.
# Os scripts leem este arquivo automaticamente.

# OBRIGATORIO: token da API da Apify
# Pegue em: https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPCIONAL: sobrescrever os actors padrao (caso queira trocar por outro do store).
# Formato slug: owner~nome-do-actor
# APIFY_ACTOR_GOOGLE_MAPS=compass~crawler-google-places
# APIFY_ACTOR_INSTAGRAM=apify~instagram-scraper
# APIFY_ACTOR_TIKTOK=clockworks~tiktok-scraper
# APIFY_ACTOR_FACEBOOK_ADS=apify~facebook-ads-scraper
